---
/**
 * InstagramEmbeds — the real posts, rendered by Instagram's own embed script.
 *
 * Media, captions and carousel arrows all come from Instagram at full
 * resolution, so nothing here goes stale when a post is edited and no image is
 * copied into the repo. The costs are real and deliberate: their embed.js plus
 * one iframe per post, Instagram's own chrome (like counts, hashtags, a comment
 * box), and no control over the typography inside the frame.
 *
 * Two things this component has to get right, because the naive version of it
 * would undo work already done on this site:
 *
 *   1. embed.js is fetched only when the section nears the viewport, so the
 *      pages nobody scrolls that far down never pay for it.
 *   2. Instagram hard-codes `min-width: 326px` on both the blockquote and the
 *      iframe it swaps in. At a 320px viewport that is wider than the column,
 *      which would reintroduce the horizontal overflow fixed in f5bd718. The
 *      global override below is the fix and must stay.
 *
 * If Instagram's script is blocked the blockquote never hydrates, so the markup
 * inside it is the fallback the reader actually sees — hence a real link and a
 * real caption rather than an empty box.
 */
import { instagramPosts } from '../data/instagram';
import { siteConfig } from '../data/site';

const posts = instagramPosts;
const handle = siteConfig.contact.instagram.replace(/^https?:\/\/(www\.)?instagram\.com\//, '').replace(/\/$/, '');
---

{posts.length > 0 && (
  <section id="ig-embeds" class="py-20 md:py-28 bg-stone-50 border-t border-stone-200" aria-label="Instagram highlights">
    <div class="container max-w-6xl px-6 mx-auto">
      <div class="text-center mb-12 md:mb-16 animate-on-scroll">
        <p class="chapter-number mb-4">Field Notes</p>
        <div class="chapter-divider mb-8"></div>
        <h2 class="font-playfair text-3xl md:text-4xl text-stone-900 font-medium">The Trail, As It Happens</h2>
        <p class="mt-6 text-stone-600 text-lg max-w-2xl mx-auto">
          Reels and postcards from the road, posted as we go — Shillong's backstreets, the
          markets of the hills, the long drive north.
        </p>
      </div>

      <div class="ig-grid">
        {posts.map((post) => (
          <div class="ig-slot">
            <blockquote
              class="instagram-media"
              data-instgrm-permalink={post.permalink}
              data-instgrm-version="14"
            >
              <a href={post.permalink} target="_blank" rel="noopener noreferrer" class="ig-fallback">
                <span class="ig-fallback-label">{post.type === 'reel' ? 'Reel' : 'Post'} on Instagram</span>
                <span class="ig-fallback-caption">{post.caption}</span>
              </a>
            </blockquote>
          </div>
        ))}
      </div>

      <p class="md:hidden mt-4 text-center text-stone-400 text-xs tracking-widest uppercase" aria-hidden="true">
        Swipe for more
      </p>

      <div class="mt-10 text-center animate-on-scroll">
        <a
          href={siteConfig.contact.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-5 sm:px-7 py-3.5 border border-stone-300 hover:border-amber-600 hover:text-amber-700 text-stone-700 transition-colors tracking-wide text-sm sm:text-base whitespace-nowrap"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98C.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
          </svg>
          <span>Follow @{handle}</span>
        </a>
      </div>
    </div>
  </section>
)}

<style is:global>
  /* Instagram inlines `min-width: 326px` on the blockquote and on the iframe it
     swaps in. Below ~370px of column that is wider than the page, which is how
     the horizontal-overflow bug comes back. Inline styles lose to !important. */
  .instagram-media {
    min-width: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    border-radius: 0 !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06) !important;
  }

  /* Six embeds stacked on a phone ran 4,408px — about five and a half screens,
     which pushed the consultation CTA back down the page after the work in
     fcc1548 to lift it. On mobile they become a swipe carousel instead: one
     post in view, the next one peeking to signal it scrolls. The container
     scrolls itself, so this never becomes page-level horizontal overflow. */
  .ig-grid {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }
  .ig-grid::-webkit-scrollbar { display: none; }

  .ig-slot {
    flex: 0 0 88%;
    scroll-snap-align: center;
    /* Reserve height so hydration does not shove the footer down the page.
       Released once the iframe reports its own height. */
    min-height: 32rem;
  }

  /* Wrapping flexbox rather than grid, so a row that does not divide evenly by
     the column count centres its remainder instead of leaving a hole on the
     right. With five posts in three columns that is the difference between a
     finished block and one that looks like a sixth tile failed to load. */
  @media (min-width: 768px) {
    .ig-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: flex-start;
      gap: 1.5rem;
      overflow: visible;
    }
    .ig-slot { flex: 0 0 calc((100% - 1.5rem) / 2); }
  }

  @media (min-width: 1024px) {
    .ig-slot { flex: 0 0 calc((100% - 3rem) / 3); }
  }

  .ig-fallback {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-stone-200, #e7e5e4);
    background: #fff;
    text-decoration: none;
  }
  .ig-fallback-label {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-amber-700, #b45309);
  }
  .ig-fallback-caption {
    color: var(--color-stone-700, #44403c);
    line-height: 1.5;
  }
</style>

<script is:inline data-ig-embeds>
  (() => {
    const section = document.getElementById('ig-embeds');
    if (!section) return;

    const hydrate = () => {
      // Script already on the page (client-side nav, or a second instance):
      // just ask Instagram to re-scan for un-processed blockquotes.
      if (window.instgrm && window.instgrm.Embeds) {
        window.instgrm.Embeds.process();
        return;
      }
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.instagram.com/embed.js';
      document.body.appendChild(s);
    };

    // Nobody who stops above this section should pay for embed.js.
    if (!('IntersectionObserver' in window)) { hydrate(); return; }
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      hydrate();
    }, { rootMargin: '600px 0px' });
    io.observe(section);

    // Once the iframes report a height, drop the reserved minimum so the
    // slots hug their real content instead of leaving a gap under short posts.
    const release = () => section.querySelectorAll('.ig-slot').forEach((el) => {
      const frame = el.querySelector('iframe');
      if (frame && frame.getBoundingClientRect().height > 200) el.style.minHeight = '0';
    });
    window.addEventListener('message', (e) => {
      if (typeof e.origin === 'string' && e.origin.indexOf('instagram.com') !== -1) setTimeout(release, 60);
    });
  })();
</script>

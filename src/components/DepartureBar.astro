---
/**
 * DepartureBar — slim, dismissible site-wide bar for the next fixed departure.
 * Height is published as --dep-bar-h so the fixed header and the page's top
 * padding stay in step, including after the visitor dismisses it.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'fixedDepartures'>;
  /** true when the reader is already on this departure's own page */
  onOwnPage?: boolean;
}
const { entry, onOwnPage = false } = Astro.props;
const { title, startDate, endDate, price, priceNote, status } = entry.data;

const day = (d: Date) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', timeZone: 'UTC' }).format(d);
const monthYear = (d: Date) => new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(d);
const dateRange = `${day(startDate)}–${day(endDate)} ${monthYear(endDate)}`;
const priceDisplay = new Intl.NumberFormat('en-IN').format(price);

// On the departure's own page the promo link would point at the page you are
// already reading, so the bar becomes the booking action instead — which also
// gives that very long page a persistent CTA.
const bookingMessage = 'Hello! I would like to book a seat on the "' + title + '" fixed departure (' + dateRange + '). Could you share the next steps?';
const whatsappUrl = 'https://wa.me/916002324880?text=' + encodeURIComponent(bookingMessage);
const soldOut = status === 'sold-out';
---

<div id="departure-bar" data-key={entry.id} class="fixed top-0 left-0 right-0 z-[60] bg-amber-700 text-white">
  <div class="container max-w-6xl mx-auto px-6 h-10 flex items-center justify-center gap-3 text-sm">
    {onOwnPage ? (
      <div class="flex items-center gap-3 min-w-0">
        <span class="hidden sm:inline text-amber-100 flex-shrink-0">
          <span class="font-medium">₹{priceDisplay}</span>
          <span class="text-amber-200"> {priceNote.toLowerCase()}</span>
        </span>
        <span class="text-amber-200 flex-shrink-0 hidden sm:inline" aria-hidden="true">·</span>
        <span class="text-amber-100 flex-shrink-0 hidden md:inline">{dateRange}</span>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white text-amber-800 hover:bg-amber-50 transition-colors font-medium px-4 py-1.5 rounded-sm flex-shrink-0"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          {soldOut ? 'Join the Waitlist' : 'Reserve Your Seat'}
        </a>
      </div>
    ) : (
      <a href={`/fixed-departures/${entry.id}/`} class="flex items-center gap-2.5 min-w-0 hover:underline underline-offset-4">
        <span class="hidden sm:inline text-amber-200 tracking-widest uppercase text-xs flex-shrink-0">Fixed Departure</span>
        <span class="font-medium truncate">{title}</span>
        <span class="text-amber-200 flex-shrink-0 hidden sm:inline" aria-hidden="true">·</span>
        <span class="text-amber-100 flex-shrink-0 hidden sm:inline">{dateRange}</span>
        <span class="text-amber-200 flex-shrink-0 hidden md:inline" aria-hidden="true">·</span>
        <span class="text-amber-100 flex-shrink-0 hidden md:inline">₹{priceDisplay}</span>
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    )}
  </div>
  <button
    id="departure-bar-dismiss"
    type="button"
    aria-label="Dismiss departure announcement"
    class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-amber-200 hover:text-white transition-colors"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</div>

<script is:inline data-dep-bar>
  (() => {
    const KEY = 'ttt-departure-bar-dismissed';
    const bar = document.getElementById('departure-bar');
    if (!bar) return;
    // Storage can throw (private mode, blocked site data) — the bar must still render.
    let dismissed = false;
    try { dismissed = localStorage.getItem(KEY) === bar.dataset.key; } catch {}
    if (dismissed) {
      bar.remove();
      document.documentElement.classList.add('dep-bar-hidden');
      return;
    }
    document.getElementById('departure-bar-dismiss')?.addEventListener('click', () => {
      bar.remove();
      document.documentElement.classList.add('dep-bar-hidden');
      try { localStorage.setItem(KEY, bar.dataset.key || '1'); } catch {}
    });
  })();
</script>

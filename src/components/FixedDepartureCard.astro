---
/**
 * FixedDepartureCard — one dated, priced group departure.
 * Shared by the destination pages and the homepage so the card only
 * exists in one place.
 */
import type { CollectionEntry } from 'astro:content';
import { unsplashSrcset } from '../utils/image';

interface Props {
  entry: CollectionEntry<'fixedDepartures'>;
  /** position in the list, used only for the stagger delay */
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const { title, tagline, heroImage, startDate, endDate, durationNights, durationDays, price, priceNote } = entry.data;

const day = (d: Date) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', timeZone: 'UTC' }).format(d);
const monthYear = (d: Date) => new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d);
const full = (d: Date) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d);

const dateRange =
  startDate.getUTCMonth() === endDate.getUTCMonth() && startDate.getUTCFullYear() === endDate.getUTCFullYear()
    ? `${day(startDate)}–${day(endDate)} ${monthYear(startDate)}`
    : `${full(startDate)} – ${full(endDate)}`;
---

<a
  href={`/fixed-departures/${entry.id}/`}
  class="group grid md:grid-cols-5 overflow-hidden border border-stone-200 bg-white animate-on-scroll"
  style={`transition-delay: ${index * 100}ms`}
>
  {heroImage && (
    <div class="md:col-span-2 relative overflow-hidden h-52 md:h-auto md:min-h-[16rem]">
      <img
        src={heroImage}
        srcset={unsplashSrcset(heroImage, [480, 768, 960])}
        sizes="(min-width: 768px) 40vw, 100vw"
        alt={title}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        width="960"
        height="640"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class={`p-8 flex flex-col ${heroImage ? 'md:col-span-3' : 'md:col-span-5'}`}>
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="inline-flex items-center gap-1.5 bg-amber-600/10 text-amber-700 text-sm font-medium px-3 py-1 rounded-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        {dateRange}
      </span>
      <span class="inline-flex items-center gap-1.5 bg-stone-100 text-stone-600 text-sm px-3 py-1 rounded-sm">
        {durationNights}N / {durationDays}D
      </span>
    </div>

    <h3 class="font-playfair text-2xl text-stone-900 font-medium group-hover:text-amber-600 transition-colors">
      {title}
    </h3>
    <p class="mt-3 text-stone-600 leading-relaxed flex-grow">
      {tagline}
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-stone-100">
      <div class="flex items-baseline gap-2">
        <span class="font-playfair text-2xl text-stone-900">₹{new Intl.NumberFormat('en-IN').format(price)}</span>
        <span class="text-stone-500 text-sm">{priceNote}</span>
      </div>
      <span class="inline-flex items-center gap-2 text-amber-600 text-sm font-medium">
        <span>View itinerary</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </span>
    </div>
  </div>
</a>

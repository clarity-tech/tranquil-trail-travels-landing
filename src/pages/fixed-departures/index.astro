---
/**
 * Fixed Departures hub — /fixed-departures/
 * Lists every upcoming departure; past ones drop off automatically.
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../data/site';
import FixedDepartureCard from '../../components/FixedDepartureCard.astro';

const all = await getCollection('fixedDepartures');
const upcoming = all
  .filter(d => d.data.endDate.getTime() >= Date.now())
  .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());

const canonical = new URL('/fixed-departures/', siteConfig.url).href;
const whatsappUrl = `https://wa.me/916002324880?text=${encodeURIComponent("Hello! I'd like to hear about your upcoming fixed departures.")}`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.url },
    { "@type": "ListItem", "position": 2, "name": "Fixed Departures", "item": canonical },
  ],
};
---

<Layout
  title="Fixed Departures — Tranquil Trail Travels"
  seoTitle="Fixed Departures — Small-Group Journeys Through Northeast India"
  seoDescription="Set dates, a fixed price, and a small group. Upcoming fixed-departure journeys through Assam, Arunachal Pradesh, Meghalaya and Nagaland with Tranquil Trail Travels."
  canonicalUrl={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <main>
    <nav class="bg-white border-b border-stone-200" aria-label="Breadcrumb">
      <div class="container max-w-6xl mx-auto px-6 py-4">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-stone-500">
          <li><a href="/" class="hover:text-amber-600 transition-colors">Home</a></li>
          <li aria-hidden="true">
            <svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </li>
          <li><span class="text-stone-800 font-medium" aria-current="page">Fixed Departures</span></li>
        </ol>
      </div>
    </nav>

    <section class="py-20 md:py-28 bg-white" aria-label="Upcoming fixed departures">
      <div class="container max-w-5xl px-6 mx-auto">
        <div class="text-center mb-16">
          <p class="chapter-number mb-4 animate-on-scroll">Fixed Departures</p>
          <div class="chapter-divider mb-8 animate-on-scroll delay-100"></div>
          <h1 class="font-playfair text-4xl md:text-5xl text-stone-900 font-medium animate-on-scroll delay-200">
            Journeys With a Date
          </h1>
          <p class="mt-6 text-stone-600 text-lg max-w-2xl mx-auto animate-on-scroll delay-300">
            Most of our journeys are built around you. These few are built around a date — a set
            itinerary, a fixed price, and a small group of fellow travellers. Everything is
            arranged; you just arrive.
          </p>
        </div>

        {upcoming.length > 0 ? (
          <div class="grid gap-6 md:gap-8">
            {upcoming.map((dep, i) => <FixedDepartureCard entry={dep} index={i} />)}
          </div>
        ) : (
          <div class="text-center border border-stone-200 bg-stone-50 p-12 animate-on-scroll">
            <p class="font-playfair text-2xl text-stone-900">No departures on the calendar right now.</p>
            <p class="mt-4 text-stone-600 max-w-xl mx-auto">
              We run these a few times a year. Tell us roughly when you're free and we'll let you
              know as soon as the next dates are set — or we'll craft a private journey on yours.
            </p>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="whatsapp-btn mt-8">
              <span>Ask About Next Dates</span>
            </a>
          </div>
        )}
      </div>
    </section>
  </main>

  <script>
    const o = new IntersectionObserver((es) => es.forEach(e => e.isIntersecting && e.target.classList.add('is-visible')), { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.animate-on-scroll, .chapter-reveal').forEach(el => o.observe(el));
  </script>
</Layout>
